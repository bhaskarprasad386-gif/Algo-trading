[Unit]
Description=Algo Trading Telegram Control Bot
After=network-online.target algo-trading.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/Algo-Trading/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/Algo-Trading/backend/.env
ExecStart=/opt/Algo-Trading/.venv/bin/python /opt/Algo-Trading/deploy/telegram_control_bot.py
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
