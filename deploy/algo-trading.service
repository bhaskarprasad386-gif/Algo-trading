[Unit]
Description=Algo Trading FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/Algo-Trading/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/Algo-Trading/backend/.env
ExecStart=/opt/Algo-Trading/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
