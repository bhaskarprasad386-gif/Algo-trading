# App Config
APP_NAME="Algo Trading Platform"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-super-secret-key-in-production
DATABASE_URL=sqlite:///./algo_trading.db

# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# NIFTY Weekly IV Early-Entry Telegram alerts
# Alert-only notifications; this does not enable broker order execution.
# Keep disabled until the bot token and destination chat ID are configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner page WebSocket origin allowlist (comma-separated exact scheme+host origins).
# Add the exact deployed VPS frontend origin(s); leave empty to retain localhost-only defaults.
SCANNER_PAGE_WS_ALLOWED_ORIGINS=
