# App Config
APP_NAME="Algo Trading Platform"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-super-secret-key-in-production
DATABASE_URL=sqlite:///./algo_trading.db

# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Cash-Future historical collector
# Keep disabled until broker/data connectivity is verified.
CASH_FUTURE_HISTORY_ENABLED=false
# Comma-separated NSE cash symbols, e.g. RELIANCE,SBIN,INFY
CASH_FUTURE_HISTORY_SYMBOLS=RELIANCE,SBIN
# Collection interval in seconds; application enforces a minimum of 15 seconds.
CASH_FUTURE_HISTORY_INTERVAL_SECONDS=60
# Continuous Angel One WebSocket current/near Cash-Future 1-second snapshots
LIVE_CASH_FUTURE_DATA_ENABLED=false

# Cash-Future live quality/ops
# true only when Angel One WebSocket credentials are configured.
LIVE_CASH_FUTURE_DATA_ENABLED=false
# Empty = NIFTY-50 stocks; otherwise comma-separated symbols.
LIVE_CASH_FUTURE_SYMBOLS=
LIVE_CASH_FUTURE_PAIR_TOLERANCE_SECONDS=1.0
LIVE_CASH_FUTURE_MAX_QUOTE_AGE_SECONDS=3.0
# Non-zero defaults prevent zero-cost scanner optimism; tune to actual broker/account costs.
LIVE_CASH_FUTURE_COST_BPS=10.0
LIVE_CASH_FUTURE_SLIPPAGE_BPS=5.0
LIVE_CASH_FUTURE_ALERT_COOLDOWN_SECONDS=60.0
