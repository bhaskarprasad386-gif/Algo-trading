<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#08111F" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALGO TRADING" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/><TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Checking Server Status..." android:textColor="#9FB0C7" android:textSize="12sp"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#163B32" android:padding="9dp" android:text="PAPER MODE" android:textColor="#4ADE80" android:textSize="11sp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="#101D31" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAPER BALANCE" android:textColor="#8295AE" android:textSize="10sp" android:textStyle="bold"/><TextView android:id="@+id/tvPaperBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₹10,00,000" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Virtual funds" android:textColor="#4ADE80" android:textSize="10sp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="#101D31" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REALIZED P&amp;L" android:textColor="#8295AE" android:textSize="10sp" android:textStyle="bold"/><TextView android:id="@+id/tvPaperResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₹0.00" android:textColor="#4ADE80" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Persistent account" android:textColor="#8295AE" android:textSize="10sp"/></LinearLayout></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAPER POSITION" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#102640" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="16dp"><TextView android:id="@+id/tvPaperPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No active paper position" android:textColor="#DCE6F5" android:textSize="13sp"/><Button android:id="@+id/btnPaperPosition" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="REFRESH POSITION"/><TextView android:id="@+id/tvPaperOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Orders: —" android:textColor="#9FB0C7" android:textSize="12sp" android:fontFamily="monospace"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAPER TRADE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#101D31" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="16dp"><EditText android:id="@+id/etEntryPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Entry Price" android:inputType="numberDecimal" android:text="100" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/><EditText android:id="@+id/etQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity" android:inputType="numberDecimal" android:text="1" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/><Button android:id="@+id/btnPaperEntry" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER ENTRY" android:textStyle="bold"/><EditText android:id="@+id/etExitPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Exit Price" android:inputType="numberDecimal" android:text="103.5" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:layout_marginTop="4dp"/><Button android:id="@+id/btnPaperExit" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER EXIT" android:textStyle="bold" android:layout_marginTop="4dp"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASH–FUTURE SCANNER" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/><Button android:id="@+id/btnRunScanner" android:layout_width="match_parent" android:layout_height="46dp" android:text="RUN CASH–FUTURE SCAN"/><TextView android:id="@+id/tvScannerResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scanner results will appear here." android:textColor="#DCE6F5" android:textSize="12sp" android:fontFamily="monospace" android:padding="12dp"/>
<TextView android:id="@+id/tvScannerAutoRefreshStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto Refresh: OFF" android:textColor="#8295AE" android:textSize="11sp"/><TextView android:id="@+id/tvScannerNextRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Next Refresh: —" android:textColor="#8295AE" android:textSize="11sp"/><CheckBox android:id="@+id/cbScannerAutoRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto refresh scanner" android:textColor="#DCE6F5"/><EditText android:id="@+id/etScannerRefreshSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Refresh seconds (10–300)" android:inputType="number" android:text="30" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
</LinearLayout></ScrollView>