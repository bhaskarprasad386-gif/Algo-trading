<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#08111F" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALGO TRADING" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking Server Status..." android:textColor="#9FB0C7" android:textSize="12sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#163B32" android:padding="9dp" android:text="PAPER MODE" android:textColor="#4ADE80" android:textSize="11sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
<TextView android:id="@+id/tvPaperBalance" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="#101D31" android:padding="12dp" android:text="PAPER BALANCE\n₹10,00,000" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvPaperResult" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="#101D31" android:padding="12dp" android:text="REALIZED P&amp;L\n₹0.00" android:textColor="#4ADE80" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="PAPER POSITION" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#102640" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/tvPaperPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No active paper position" android:textColor="#DCE6F5" android:textSize="13sp"/>
<Button android:id="@+id/btnPaperPosition" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="REFRESH POSITION"/>
<TextView android:id="@+id/tvPaperOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Orders: —" android:textColor="#9FB0C7" android:textSize="12sp" android:fontFamily="monospace"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="PAPER TRADE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etEntryPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Entry Price" android:inputType="numberDecimal" android:text="100" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
<EditText android:id="@+id/etQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity" android:inputType="numberDecimal" android:text="1" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
<Button android:id="@+id/btnPaperEntry" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER ENTRY"/>
<EditText android:id="@+id/etExitPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Exit Price" android:inputType="numberDecimal" android:text="103.5" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
<Button android:id="@+id/btnPaperExit" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER EXIT"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="BROKER CONNECTION" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etBrokerApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Angel One API Key" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerClientCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client Code" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
<EditText android:id="@+id/etBrokerPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Broker Password" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerTotpSecret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="TOTP Secret" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:inputType="textPassword"/>
<Button android:id="@+id/btnConnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="CONNECT ANGEL ONE"/>
<Button android:id="@+id/btnDisconnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISCONNECT BROKER"/>
<TextView android:id="@+id/tvBrokerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Broker Status: Not checked" android:textColor="#9FB0C7" android:padding="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="REAL TRADING SAFETY" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvSafetyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Safety: OFF • Kill Switch: ON" android:textColor="#FBBF24" android:padding="8dp"/>
<TextView android:id="@+id/tvSafetyRouting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live order routing: DISABLED" android:textColor="#9FB0C7"/>
<Button android:id="@+id/btnEnableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="ENABLE REAL TRADING SAFETY"/>
<Button android:id="@+id/btnDisableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISABLE REAL TRADING"/>
<Button android:id="@+id/btnKillSwitch" android:layout_width="match_parent" android:layout_height="46dp" android:text="KILL SWITCH"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="CASH–FUTURE SCANNER" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
<Button android:id="@+id/btnRunScanner" android:layout_width="match_parent" android:layout_height="46dp" android:text="RUN CASH–FUTURE SCAN"/>
<TextView android:id="@+id/tvScannerResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scanner results will appear here." android:textColor="#DCE6F5" android:textSize="12sp" android:fontFamily="monospace" android:padding="12dp"/>
<TextView android:id="@+id/tvScannerAutoRefreshStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto Refresh: OFF" android:textColor="#8295AE" android:textSize="11sp"/>
<TextView android:id="@+id/tvScannerNextRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Next Refresh: —" android:textColor="#8295AE" android:textSize="11sp"/>
<CheckBox android:id="@+id/cbScannerAutoRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto refresh scanner" android:textColor="#DCE6F5"/>
<EditText android:id="@+id/etScannerRefreshSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Refresh seconds (10–300)" android:inputType="number" android:text="30" android:textColor="#FFFFFF" android:textColorHint="#8295AE"/>
</LinearLayout>
</ScrollView>