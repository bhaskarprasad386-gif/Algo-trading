<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/mainScroll" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/algo_bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALGO TRADING" android:textColor="@color/algo_text" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking Server Status..." android:textColor="@color/algo_muted" android:textSize="12sp"/><LinearLayout android:id="@+id/marketControlCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface" android:padding="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MARKET CONTROL CENTER" android:textColor="@color/algo_text" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvMarketFeedStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Live feed: CHECKING • Orders: OFF" android:textColor="@color/algo_muted" android:textSize="11sp"/>
<Button android:id="@+id/btnMarketOverviewRefresh" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="REFRESH LIVE MARKET"/>
<TextView android:id="@+id/tvIndexOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="NSE / BSE INDEX DATA\nWaiting for live quote…" android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
<TextView android:id="@+id/tvCommodityOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="COMMODITY DATA\nWaiting for live quote…" android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
</LinearLayout>

<LinearLayout android:id="@+id/liveDataQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface_elevated" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE DATA QUALITY CENTER" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/><TextView android:id="@+id/tvLiveDataQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Persistence: CHECKING\nFeed: CHECKING\nRecords: — • Instruments: —\nData age: — • Session: —\nLive broker orders: OFF" android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/><Button android:id="@+id/btnLiveDataHealthRefresh" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="REFRESH DATA HEALTH"/></LinearLayout><LinearLayout android:id="@+id/dashboardCustomization" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface_elevated" android:padding="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DASHBOARD CUSTOMIZATION" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Choose which control-center widgets are visible on this device." android:textColor="@color/algo_muted" android:textSize="11sp"/>
<CheckBox android:id="@+id/cbShowMarket" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Market Watch" android:textColor="@color/algo_text_secondary"/>
<CheckBox android:id="@+id/cbShowAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Alert Center" android:textColor="@color/algo_text_secondary"/>
<CheckBox android:id="@+id/cbShowStrategy" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Strategy Center" android:textColor="@color/algo_text_secondary"/>
<CheckBox android:id="@+id/cbShowResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Results / Journal" android:textColor="@color/algo_text_secondary"/>
<Button android:id="@+id/btnSaveDashboardLayout" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:text="SAVE DASHBOARD LAYOUT"/>
<Button android:id="@+id/btnResetDashboardLayout" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="RESET DEFAULT LAYOUT"/>
<TextView android:id="@+id/tvDashboardLayoutStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Layout: DEFAULT • saved on this device" android:textColor="@color/algo_muted" android:textSize="11sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/phase12Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface_elevated" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHASE 12 • MOBILE NAVIGATION" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Compact mobile cards + quick actions • same backend/API/data contract as Web" android:textColor="@color/algo_muted" android:textSize="11sp"/><HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btnQuickMarket" android:layout_width="wrap_content" android:layout_height="40dp" android:text="MARKET"/><Button android:id="@+id/btnQuickScanner" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:text="BOX SPREAD"/><Button android:id="@+id/btnQuickStrategies" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:text="STRATEGIES"/><Button android:id="@+id/btnQuickResults" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:text="RESULTS"/><Button android:id="@+id/btnQuickExpansion" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:text="EXPANSION"/></LinearLayout></HorizontalScrollView></LinearLayout><Button android:id="@+id/btnAppUpdate" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="CHECK APP UPDATE"/><Button android:id="@+id/btnStrategies" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="STRATEGIES"/><Button android:id="@+id/btnResultsJournal" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="RESULTS / JOURNAL"/><Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="LOG OUT"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="PHASE 10 • BACKTEST &amp; RESULTS WORKSPACE\nHistorical data → strategy configuration → execution model → Results / Journal" android:textColor="@color/algo_text_secondary" android:textSize="11sp"/><Button android:id="@+id/btnFullFnoBacktest" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="OPEN FULL-F&amp;O BACKTEST"/>
<Button android:id="@+id/btnBoxSpread" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="OPEN BOX SPREAD"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="BROKER CONNECTION" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etBrokerApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Angel One API Key" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerClientCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client Code" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
<EditText android:id="@+id/etBrokerPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Broker Password" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerTotpSecret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="TOTP Secret" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<Button android:id="@+id/btnConnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="CONNECT ANGEL ONE"/>
<Button android:id="@+id/btnDisconnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISCONNECT BROKER"/>
<TextView android:id="@+id/tvBrokerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Broker Status: Not checked" android:textColor="@color/algo_muted" android:padding="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="REAL TRADING SAFETY" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvSafetyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Safety: OFF • Kill Switch: ON" android:textColor="@color/algo_warning" android:padding="8dp"/>
<TextView android:id="@+id/tvSafetyRouting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live order routing: DISABLED" android:textColor="@color/algo_muted"/>
<Button android:id="@+id/btnEnableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="ENABLE REAL TRADING SAFETY"/>
<Button android:id="@+id/btnDisableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISABLE REAL TRADING"/>
<Button android:id="@+id/btnKillSwitch" android:layout_width="match_parent" android:layout_height="46dp" android:text="KILL SWITCH"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="ALERT CENTER" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/><TextView android:id="@+id/tvAlertCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@color/algo_surface_elevated" android:padding="12dp" android:text="No alert events received yet." android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
<LinearLayout android:id="@+id/phase13Expansion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface_elevated" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHASE 13 • EXPANSION CENTER" android:textColor="@color/algo_paper_text" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="FINAL PHASE • Add modules without rebuilding the core." android:textColor="@color/algo_muted" android:textSize="11sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="INDICES / EXCHANGES  •  COMMODITIES / CURRENCY
STRATEGIES / SCANNERS  •  DATA SOURCES
ANALYTICS / CHARTS  •  NOTIFICATIONS
BROKER ADAPTERS  •  USER-SPECIFIC LAYOUTS" android:textColor="@color/algo_text_secondary" android:textSize="12sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="CORE LOCK: reuse the same market-data, strategy, result, alert and execution contracts. Real broker routing remains OFF." android:textColor="@color/algo_muted" android:textSize="10sp"/></LinearLayout>
</LinearLayout>
</ScrollView>