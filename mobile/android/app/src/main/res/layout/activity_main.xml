<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/algo_bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALGO TRADING" android:textColor="@color/algo_text" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking Server Status..." android:textColor="@color/algo_muted" android:textSize="12sp"/><LinearLayout android:id="@+id/marketControlCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@color/algo_surface" android:padding="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MARKET CONTROL CENTER" android:textColor="@color/algo_text" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvMarketFeedStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Live feed: CHECKING • Orders: OFF" android:textColor="@color/algo_muted" android:textSize="11sp"/>
<Button android:id="@+id/btnMarketOverviewRefresh" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="REFRESH LIVE MARKET"/>
<TextView android:id="@+id/tvIndexOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="NSE / BSE INDEX DATA\nWaiting for live quote…" android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
<TextView android:id="@+id/tvCommodityOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="COMMODITY DATA\nWaiting for live quote…" android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace"/>
</LinearLayout>

<Button android:id="@+id/btnAppUpdate" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="CHECK APP UPDATE"/><Button android:id="@+id/btnStrategies" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="STRATEGIES"/><Button android:id="@+id/btnResultsJournal" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="RESULTS / JOURNAL"/><Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="LOG OUT"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/algo_paper_surface" android:padding="9dp" android:text="PAPER MODE" android:textColor="@color/algo_paper_text" android:textSize="11sp" android:textStyle="bold"/>
<Button android:id="@+id/btnFullFnoBacktest" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="OPEN FULL-F&amp;O BACKTEST"/>
<Button android:id="@+id/btnBoxSpread" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="OPEN BOX SPREAD"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
<TextView android:id="@+id/tvPaperBalance" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@color/algo_surface" android:padding="12dp" android:text="PAPER BALANCE\n₹10,00,000" android:textColor="@color/algo_text" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvPaperResult" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@color/algo_surface" android:padding="12dp" android:text="REALIZED P&amp;L\n₹0.00" android:textColor="@color/algo_paper_text" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="PAPER POSITION" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/algo_surface_elevated" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/tvPaperPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No active paper position" android:textColor="@color/algo_text_secondary" android:textSize="13sp"/>
<Button android:id="@+id/btnPaperPosition" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="REFRESH POSITION"/>
<TextView android:id="@+id/tvPaperOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Orders: —" android:textColor="@color/algo_muted" android:textSize="12sp" android:fontFamily="monospace"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="PAPER TRADE" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etEntryPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Entry Price" android:inputType="numberDecimal" android:text="100" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
<EditText android:id="@+id/etQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity" android:inputType="numberDecimal" android:text="1" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
<Button android:id="@+id/btnPaperEntry" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER ENTRY"/>
<EditText android:id="@+id/etExitPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Exit Price" android:inputType="numberDecimal" android:text="103.5" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
<Button android:id="@+id/btnPaperExit" android:layout_width="match_parent" android:layout_height="46dp" android:text="PAPER EXIT"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="BROKER CONNECTION" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etBrokerApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Angel One API Key" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerClientCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client Code" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
<EditText android:id="@+id/etBrokerPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Broker Password" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<EditText android:id="@+id/etBrokerTotpSecret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="TOTP Secret" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted" android:inputType="textPassword"/>
<Button android:id="@+id/btnConnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="CONNECT ANGEL ONE"/>
<Button android:id="@+id/btnDisconnectBroker" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISCONNECT BROKER"/>
<TextView android:id="@+id/tvBrokerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Broker Status: Not checked" android:textColor="@color/algo_muted" android:padding="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="REAL TRADING SAFETY" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvSafetyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Safety: OFF • Kill Switch: ON" android:textColor="@color/algo_warning" android:padding="8dp"/>
<TextView android:id="@+id/tvSafetyRouting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live order routing: DISABLED" android:textColor="@color/algo_muted"/>
<Button android:id="@+id/btnEnableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="ENABLE REAL TRADING SAFETY"/>
<Button android:id="@+id/btnDisableRealTrading" android:layout_width="match_parent" android:layout_height="46dp" android:text="DISABLE REAL TRADING"/>
<Button android:id="@+id/btnKillSwitch" android:layout_width="match_parent" android:layout_height="46dp" android:text="KILL SWITCH"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="CASH–FUTURE SCANNER" android:textColor="@color/algo_text" android:textSize="14sp" android:textStyle="bold"/>
<Button android:id="@+id/btnRunScanner" android:layout_width="match_parent" android:layout_height="46dp" android:text="RUN CASH–FUTURE SCAN"/>
<Button android:id="@+id/btnScannerPaperExecute" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="PAPER EXECUTE • NO EXECUTABLE OPPORTUNITY" android:enabled="false"/>
<TextView android:id="@+id/tvScannerResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scanner results will appear here." android:textColor="@color/algo_text_secondary" android:textSize="12sp" android:fontFamily="monospace" android:padding="12dp"/>
<TextView android:id="@+id/tvScannerAutoRefreshStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto Refresh: OFF" android:textColor="@color/algo_muted" android:textSize="11sp"/>
<TextView android:id="@+id/tvScannerNextRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Next Refresh: —" android:textColor="@color/algo_muted" android:textSize="11sp"/>
<CheckBox android:id="@+id/cbScannerAutoRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto refresh scanner" android:textColor="@color/algo_text_secondary"/>
<EditText android:id="@+id/etScannerRefreshSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Refresh seconds (10–300)" android:inputType="number" android:text="30" android:textColor="@color/algo_text" android:textColorHint="@color/algo_muted"/>
</LinearLayout>
</ScrollView>