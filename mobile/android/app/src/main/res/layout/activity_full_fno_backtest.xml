<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#050B14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL F&amp;O BACKTEST"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFullFnoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#162A42"
            android:padding="12dp"
            android:text="READY • Historical F&amp;O data only • Live orders OFF"
            android:textColor="#8FF0C5"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressFullFno"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#102238"
            android:padding="12dp"
            android:text="Full F&amp;O backtest runs on accumulated/materialized historical data. It does not start live market-data subscriptions or broker orders."
            android:textColor="#DDEBFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFullFnoStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="START FULL F&amp;O BACKTEST"
            android:textColor="#FFFFFF"
            android:backgroundTint="#246BFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFullFnoCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="CANCEL"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9B3B48" />

            <Button
                android:id="@+id/btnFullFnoLoadMore"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="LOAD MORE"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0A8B79" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFullFnoPurge"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="PURGE RESULT CHUNKS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5A3B66" />

        <TextView
            android:id="@+id/tvFullFnoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0B1727"
            android:padding="12dp"
            android:text="No results loaded."
            android:textColor="#DDEBFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
