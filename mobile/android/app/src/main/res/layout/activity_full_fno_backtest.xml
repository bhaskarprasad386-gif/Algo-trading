<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#08111F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FULL F&amp;O BACKTEST"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Incremental results • low RAM"
            android:textColor="#70839D"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvFullFnoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#102033"
            android:padding="12dp"
            android:text="Ready"
            android:textColor="#DCE6F5"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressFullFno"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGapCalendar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="OPEN GAP CALENDAR"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGapCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0D1A2A"
            android:padding="10dp"
            android:text="Select a date to see the stock with the largest opening gap × lot size."
            android:textColor="#DCE6F5"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:id="@+id/llGapCalendarRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="INTRADAY REPLAY • 15 MIN CHART / 1 MIN STEP"
            android:textColor="#9FB0C7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntradayReplayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0D1A2A"
            android:padding="10dp"
            android:text="Tap GRAPH beside a calendar row to replay that stock/date."
            android:textColor="#DCE6F5"
            android:textSize="12sp" />

        <com.algotrading.app.IntradayReplayView
            android:id="@+id/intradayReplayView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="6dp"
            android:background="#07101C" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIntradayReplayPlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="PLAY 1 MIN"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnIntradayReplayReset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="RESET"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFullFnoStart"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="START FULL-F&amp;O BACKTEST"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnFullFnoCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="CANCEL BACKTEST"
            android:textSize="13sp"
            android:enabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFullFnoLoadMore"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="LOAD NEXT 50"
                android:textSize="12sp"
                android:enabled="false" />

            <Button
                android:id="@+id/btnFullFnoPurge"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="PURGE RESULTS"
                android:textSize="12sp"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="RESULTS"
            android:textColor="#9FB0C7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGapResultSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="Search: this month / 2026-09 / 2026-09-10"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#DCE6F5"
                android:textColorHint="#70839D"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGapResultSearch"
                android:layout_width="92dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:text="SEARCH"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFullFnoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0D1A2A"
            android:padding="10dp"
            android:textColor="#DCE6F5"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:minHeight="240dp" />

    </LinearLayout>
</ScrollView>
