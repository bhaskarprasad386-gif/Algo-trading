<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#08111F">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FULL F&O BACKTEST" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvFullFnoStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready" android:textColor="#9FB0C7" android:textSize="12sp" />
    <Button android:id="@+id/btnFullFnoStart" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:text="START FULL-F&amp;O BACKTEST" />
    <Button android:id="@+id/btnFullFnoLoadMore" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="LOAD NEXT 50 RESULTS" android:enabled="false" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
        <TextView android:id="@+id/tvFullFnoResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DCE6F5" android:textSize="12sp" android:fontFamily="monospace" android:padding="8dp" />
    </ScrollView>
</LinearLayout>
