<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Algo Trading" android:textSize="30sp" android:textStyle="bold" android:gravity="center" android:paddingBottom="8dp" />
        <TextView android:id="@+id/tvAuthMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Login to continue" android:textSize="18sp" android:gravity="center" android:paddingBottom="24dp" />
        <EditText android:id="@+id/etAuthIdentifier" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email or mobile number" android:inputType="text" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/etAuthPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password" android:inputType="textPassword" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/etAuthName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Full name (Sign Up only)" android:inputType="textCapWords" android:visibility="gone" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnAuthSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOGIN" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnAuthForgot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FORGOT PASSWORD" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnAuthToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CREATE ACCOUNT" />
        <TextView android:id="@+id/tvAuthResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:paddingTop="16dp" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
