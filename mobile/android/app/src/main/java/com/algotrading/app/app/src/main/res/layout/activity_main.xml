<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking Server Status..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:gravity="center" />

    <EditText
        android:id="@+id/etSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Symbol (e.g. RELIANCE)"
        android:text="RELIANCE"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnFetchQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetch Bid / Ask Quote"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvQuoteDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter a symbol above and click the button to view quotes."
        android:textSize="16sp"
        android:lineSpacingExtra="8dp"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:textColor="#333333" />

</LinearLayout>
